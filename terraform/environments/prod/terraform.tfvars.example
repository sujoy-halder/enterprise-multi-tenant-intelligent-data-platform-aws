project_name        = "enterprise-data-platform"
environment         = "prod"
aws_region          = "us-east-1"
cost_center         = "data-platform"
alert_email         = "data-platform-alerts@example.com"
eks_cluster_version = "1.30"

availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc_cidr           = "10.50.0.0/16"
private_subnets    = ["10.50.10.0/23", "10.50.12.0/23", "10.50.14.0/23"]
public_subnets     = ["10.50.100.0/24", "10.50.101.0/24", "10.50.102.0/24"]

domain_names = ["retail", "healthcare", "finance", "logistics"]

enable_msk = true
